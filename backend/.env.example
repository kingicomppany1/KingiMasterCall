# Postgres (Supabase: Project Settings > Database > connection string)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# Supabase Auth (used to verify login tokens and to create agent logins)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=          # Settings > API > JWT secret (leave empty if project uses asymmetric keys; JWKS is used then)

# Africa's Talking (Voice)
AT_USERNAME=
AT_API_KEY=
AT_PHONE_NUMBER=+234XXXXXXXXXX
AT_WEBHOOK_SECRET=            # long random string; callback URL: https://<api-host>/at/voice?secret=<this>
AT_RATE_NGN_PER_MIN=15        # fallback if AT sends no amount
AT_MAX_CALL_SECONDS=1800

CORS_ORIGINS=http://localhost:3000
